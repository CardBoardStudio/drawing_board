# Reference only; the server reads process environment, not .env files.
BIND_ADDR=127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=drawing-board.sqlite
# Local testing only; leave unset when serving other users.
# DEV_AUTH=1
# NIDO_SIGNERS_FILE=/absolute/path/to/trusted-signers.local.json
RUST_LOG=info
# Container hosts may set PORT instead of BIND_ADDR.
# PORT=3000
# Render provides RENDER, IS_PULL_REQUEST, and RENDER_EXTERNAL_URL.
# PREVIEW_AUTH=1
# PREVIEW_ACCESS_CODE=<random value of at least 24 characters>
